# ===========================================
# Local Environment Variables
# ===========================================
# Copy this file to .env and fill in all values.
# Never commit the real .env file.

# --- Proxmox (used by terraform locally) ---
TF_ENDPOINT=CHANGE_ME              # e.g. https://192.168.1.50:8006/
TF_SECRET=CHANGE_ME                # e.g. root@pam!tailscale=xxxxxxxx-...
SSH_PUBLIC_KEY=CHANGE_ME            # e.g. ssh-ed25519 AAAA... you@email.com

# --- Ansible (export these before running ansible locally) ---
TAILSCALE_AUTH_KEY=CHANGE_ME        # tskey-auth-...
SAMBA_USER_PASSWORD=CHANGE_ME


# ===========================================
# GitHub Actions Secrets
# ===========================================
# Add each of these individually in:
# Repo → Settings → Secrets and variables → Actions
#
# DESKTOP_IP          - your desktop's public IP (e.g. 23.17.81.63)
# DESKTOP_USER        - your desktop SSH username (e.g. williamewanchuk)
# SSH_PRIVATE_KEY     - full contents of ~/.ssh/id_ed25519 (private key)
# SSH_PUBLIC_KEY      - full contents of ~/.ssh/id_ed25519.pub
# CONTAINER_SSH_KEY   - SSH private key for accessing the container
# TF_ENDPOINT         - same as above, Proxmox API URL
# TF_SECRET           - same as above, Proxmox API token
# TAILSCALE_AUTH_KEY  - same as above, tskey-auth-...
# SAMBA_USER_PASSWORD - same as above, samba user password
# SERVER_IP           - LXC container's local IP (e.g. 192.168.1.55)
